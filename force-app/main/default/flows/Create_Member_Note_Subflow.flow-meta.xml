<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Build_Case_Note</name>
        <label>Build Case Note</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>selectedRelatedCaseId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Case.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>noteText</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>getCaseNoteFormula</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>wasSuccessful</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Boost_Member_Note</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Build_Custom_Note</name>
        <label>Build Custom Note</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>noteText</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>customNote</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>wasSuccessful</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Boost_Member_Note</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Use_Template_Note</name>
        <label>Use Template Note</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>noteText</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>noteType</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>wasSuccessful</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Boost_Member_Note</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Determine_Note_Path</name>
        <label>Determine Note Path</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Use_Template_Note</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>See_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>noteType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>See case and advise</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Case</targetReference>
            </connector>
            <label>See Case</label>
        </rules>
        <rules>
            <name>Other</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>noteType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Other</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Build_Custom_Note</targetReference>
            </connector>
            <label>Other</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>getCaseNoteFormula</name>
        <dataType>String</dataType>
        <expression>&quot;See case &quot; &amp; {!Get_Case.CaseNumber} &amp; &quot; and advice&quot;</expression>
    </formulas>
    <interviewLabel>Create Member Note Subflow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Member Note Subflow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Boost_Member_Note</name>
        <label>Create Boost Member Note</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Boost__c</field>
            <value>
                <elementReference>boostId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Note_Text__c</field>
            <value>
                <elementReference>noteText</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Note_Type__c</field>
            <value>
                <elementReference>noteType</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Related_Case__c</field>
            <value>
                <elementReference>selectedRelatedCaseId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Source__c</field>
            <value>
                <elementReference>sourceValue</elementReference>
            </value>
        </inputAssignments>
        <object>Boost_Member_Note__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Case</name>
        <label>Get Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Build_Case_Note</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>selectedRelatedCaseId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Determine_Note_Path</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>errorMessageTemplate</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;errorMessage = &apos;No Case was found for case number &apos; &amp;amp; {!caseNumberInput}&lt;/p&gt;</text>
    </textTemplates>
    <variables>
        <name>boostId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>caseNumberInput</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>customNote</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>debugTest</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>errorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>noteText</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>noteType</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>selectedRelatedCaseId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>sourceValue</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>wasSuccessful</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
